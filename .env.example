# Copy this file to .env.local and fill in your values. Never commit .env.local.

# --- Required from Phase 1 ------------------------------------------------

# Google PageSpeed Insights API key (free).
# Create it at https://console.cloud.google.com/apis/credentials, after enabling
# "PageSpeed Insights API" for the project. Keyless calls currently get a quota of 0.
PAGESPEED_API_KEY=

# Upstash Redis, used for the 5-minute cache and per-IP rate limiting (free tier).
# Create a database at https://console.upstash.com and copy the REST URL and token.
# In development these can stay empty: caching and rate limiting switch off with a
# warning. In production the server refuses to start without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional -------------------------------------------------------------

# Points the app at a different PSI endpoint, for local testing against a mock.
# PAGESPEED_API_URL=
