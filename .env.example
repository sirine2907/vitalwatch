# Copy this file to .env.local and fill in your values. Never commit .env.local.

# --- PageSpeed Insights (Phase 1) -----------------------------------------

# Required. Free. Create it at https://console.cloud.google.com/apis/credentials,
# after enabling "PageSpeed Insights API". Keyless calls currently get a quota of 0.
PAGESPEED_API_KEY=

# --- Upstash Redis (Phase 1) ----------------------------------------------

# Used for the 5-minute cache and rate limits. Free tier: https://console.upstash.com
# In development these can stay empty: caching and limits switch off with a warning.
# In production the server won't serve requests without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Database (Phase 2) ---------------------------------------------------

# Required for accounts and history. A free Neon or Supabase database both work.
# Use the pooled connection string here.
DATABASE_URL=

# Optional. The direct (non-pooled) connection string, used only by `npm run db:migrate`.
# DATABASE_MIGRATION_URL=

# --- Sign-in (Phase 2) ----------------------------------------------------

# Required. Any long random string. Generate one with: npx auth secret
AUTH_SECRET=

# Required in production: GitHub is the main login. Create an OAuth app at
# https://github.com/settings/developers with this callback URL:
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: email magic links. Free key at https://resend.com/api-keys
RESEND_API_KEY=

# Resend's test sender only reaches your own Resend account's address, so set that
# address here to limit email sign-in to it. Remove this once you have a verified domain.
EMAIL_OWNER_ADDRESS=

# Optional. Only change this once you have a verified domain.
# EMAIL_FROM=VitalWatch <alerts@yourdomain.com>

# Only needed when running `npm start` outside Vercel:
# AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# --- Scheduled monitoring (Phase 3) ----------------------------------------

# Required in production. The public URL of your deployment, used in alert emails,
# share links and as the address QStash calls. Defaults to http://localhost:3000.
APP_URL=

# Free tier: https://console.upstash.com/qstash (Request Builder page shows all three).
# In local development these can stay empty: `npm run jobs:dispatch` runs jobs directly.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- AI fix suggestions (Phase 4) -----------------------------------------

# Optional. Free key at https://aistudio.google.com/apikey. Without any AI key, the
# suggestions button is hidden. Free-tier data may be used by Google to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Optional and paid. If set, Claude is used instead of Gemini.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional. AI suggestions each user can generate per day (default 10).
# AI_DAILY_LIMIT_PER_USER=10

# --- Testing --------------------------------------------------------------

# Optional. Point the app at local mocks instead of the real services.
# PAGESPEED_API_URL=
# QSTASH_URL=
# GEMINI_API_URL=
# RESEND_BASE_URL=
